# Preencha apenas a chave para ativar o chat. Reinicie npm start após editar.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4o-mini
# Vazio: o outro modelo acima será a alternativa; no máximo 2 tentativas no total.
OPENAI_FALLBACK_MODEL=
AI_SIMPLE_TOKENS=160
AI_BRIEF_TOKENS=360
AI_DETAILED_TOKENS=800
AI_CONTEXT_CHARS=6000
PORT=3000
HOST=127.0.0.1
AI_TIMEOUT_MS=30000
