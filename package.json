{
  "name": "squad-f",
  "version": "1.0.0",
  "private": true,
  "description": "Portfólio acadêmico do Squad F com chat de IA",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "node --watch src/backend/server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:live": "node scripts/test-chat-live.js",
    "test:all": "npm test && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test:all"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6"
  }
}
